# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files
COPY ["UserDirectoryApi.csproj", "./"]
COPY ["Controllers/", "Controllers/"]
COPY ["Data/", "Data/"]
COPY ["Models/", "Models/"]
COPY ["Migrations/", "Migrations/"]
COPY ["Properties/", "Properties/"]
COPY ["Program.cs", "./"]

# Restore and build
RUN dotnet restore "UserDirectoryApi.csproj"
RUN dotnet build "UserDirectoryApi.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "UserDirectoryApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create data directory for SQLite database
RUN mkdir -p /app/data

# Expose port
EXPOSE 5096

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5096/health || exit 1

# Run the application
ENTRYPOINT ["dotnet", "UserDirectoryApi.dll"]